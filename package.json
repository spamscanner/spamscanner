{
  "name": "spamscanner",
  "description": "Spam, phishing and malware filter for email in any language: a trainable classifier, link and attachment checks, SPF/DKIM/DMARC, and an optional AI second opinion from any LLM, including local Ollama models. Works as a library, CLI, Postfix milter or HTTP API.",
  "version": "7.0.0",
  "author": "Forward Email (https://forwardemail.net)",
  "bin": {
    "spamscanner": "./dist/esm/cli.js"
  },
  "bugs": {
    "url": "https://github.com/spamscanner/spamscanner/issues"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "reporter": [
      "text",
      "lcov",
      "json-summary"
    ],
    "check-coverage": true,
    "branches": 100,
    "functions": 100,
    "lines": 100,
    "statements": 100
  },
  "contributors": [
    "Forward Email (https://forwardemail.net)"
  ],
  "dependencies": {
    "franc": "^6.2.0",
    "mailauth": "^4.13.3",
    "mailparser": "^3.9.16",
    "tldts": "^7.0.17"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "c8": "^10.1.3",
    "esbuild": "^0.28.2",
    "fixpack": "^4.0.0",
    "husky": "^9.1.7",
    "hyparquet": "^1.31.2",
    "lint-staged": "^15.5.2",
    "marked": "^17.0.6",
    "remark-cli": "^11.0.0",
    "remark-lint-no-heading-punctuation": "^2.0.1",
    "remark-preset-github": "^4.0.4",
    "remark-retext": "^4.0.0",
    "typescript": "^5.9.3",
    "xo": "^1.2.3"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./arf": {
      "types": "./dist/types/arf.d.ts",
      "import": "./dist/esm/arf.js",
      "require": "./dist/cjs/arf.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "model/"
  ],
  "homepage": "https://spamscanner.net",
  "keywords": [
    "anti-spam",
    "antispam",
    "arf",
    "bayes",
    "bayesian",
    "clamav",
    "classifier",
    "dkim",
    "dmarc",
    "email",
    "email-security",
    "filter",
    "llm",
    "mail",
    "milter",
    "multilingual",
    "ollama",
    "phishing",
    "postfix",
    "scam",
    "sendmail",
    "spam",
    "spam-filter",
    "spamassassin",
    "spamassassin-alternative",
    "spf",
    "virus"
  ],
  "license": "BUSL-1.1",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "packageManager": "pnpm@10.34.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spamscanner/spamscanner.git"
  },
  "scripts": {
    "build": "node build.mjs && tsc --project tsconfig.json",
    "i18n:check": "node scripts/i18n-check.js",
    "lint": "fixpack && remark . -qfo && xo --fix",
    "model:train": "node scripts/train-model.js",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "pretest": "npm run lint && npm run build",
    "site:build": "node scripts/build-site.js",
    "site:check": "node scripts/check-links.js",
    "site:serve": "node scripts/serve.js",
    "test": "c8 node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts"
}
