{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "rootDir": "src"
  },
  "include": [
    "src/**/*.js"
  ],
  "exclude": [
    "src/bin.js"
  ]
}
