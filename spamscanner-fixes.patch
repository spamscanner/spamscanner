+    echo -e "${GREEN}║  ✓ Successfully installed ${version}${NC}"
     echo -e "${GREEN}╚═══════════════════════════════════════════════════════════╝${NC}"
     echo ""
+
+    if [[ ":$PATH:" != *":$bin_dir:"* ]]; then
+        echo -e "Add ${bin_dir} to your PATH:"
+        echo -e "  export PATH=\"${bin_dir}:\$PATH\""
+        echo ""
+    fi
+
     echo -e "You can now run:"
     echo -e "  ${BLUE}spamscanner --help${NC}          Show help"
