+
+    echo -e "Platform: ${GREEN}${platform}-${arch}${NC}"
+    echo ""
+
+    # The checksum tool, chosen before anything is downloaded.
+    local sha256
+    if command -v sha256sum &> /dev/null; then
+        sha256="sha256sum"
+    elif command -v shasum &> /dev/null; then
+        sha256="shasum -a 256"
